# Copy this file to .env.local and fill in your own values. .env.local is git-ignored.

# Your Anthropic API key (https://console.anthropic.com). Set a monthly spend limit there.
# Leave this unset, or set MOCK_AI=1, to run with canned answers and no API calls.
ANTHROPIC_API_KEY=

# Optional: override the model. Defaults to claude-sonnet-5.
# MODEL=claude-sonnet-5

# Optional: return canned answers without calling the API.
# MOCK_AI=1
